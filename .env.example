# ============================================
# MEDIA DOWNLOADER - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.

# --- Instagram Credentials ---
# Required for downloading stories, private content, and avoiding rate limits.
# Use a dedicated/burner account, NOT your primary one.
IG_USERNAME=
IG_PASSWORD=

# --- Facebook Cookies ---
# Optional. Export your cookies.txt using a browser extension (e.g., "Get cookies.txt LOCALLY")
# Required for downloading restricted/private Facebook videos.
FB_COOKIES_FILE=

# --- FFmpeg Path ---
# Leave empty if ffmpeg is already in your system PATH.
# Otherwise, set the full path to the ffmpeg executable.
# Example: C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=

# --- aria2c Path ---
# Optional. If aria2c is installed and in PATH, leave empty.
# Otherwise, set the full path to the aria2c executable.
# Enables multi-connection downloads for YouTube (much faster).
ARIA2C_PATH=

# --- Download Directory ---
# Default: 01_Downloader/downloads (relative to project root)
# Set an absolute path to override.
DOWNLOAD_DIR=

# --- Parallel Download Workers ---
# Number of parallel downloads for bulk mode (default: 4, max: 8)
BULK_WORKERS=4
